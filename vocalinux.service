[Unit]
Description=Vocalinux Voice Dictation Service
Documentation=https://github.com/jatinkrmalik/vocalinux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/vocalinux/venv/bin/vocalinux
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target default.target
